# Frontend build-time configuration.
#
# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Flutter reads these with --dart-define-from-file, which bakes the values into
# the binary at compile time. They are NOT loaded at runtime, so there is no
# .env to ship and nothing to add to pubspec assets:
#
#   flutter run  --dart-define-from-file=.env
#   flutter test --dart-define-from-file=.env
#   flutter build web --dart-define-from-file=.env
#
# Anything here ends up readable inside the built app. Only public values
# belong in this file — never the database URL or a service_role key.

# Supabase project URL. Dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://itdtgxivplcqsepaorvp.supabase.co

# Supabase publishable key, starts with sb_publishable_.
# Dashboard -> Project Settings -> API Keys -> Publishable key.
# Safe to ship in a client: it only grants what row-level security allows.
# This replaced the legacy `anon` JWT; older projects can use that instead,
# from the "Legacy anon, service_role API keys" tab.
#
# Never put the sb_secret_ key here — it bypasses row-level security and would
# be readable by anyone who opens the built app.
SUPABASE_PUBLISHABLE_KEY=

# Where the FastAPI backend is reachable FROM THE DEVICE RUNNING THE APP:
#   web / desktop        http://localhost:8000
#   Android emulator     http://10.0.2.2:8000   (10.0.2.2 is the host machine)
#   iOS simulator        http://localhost:8000
#   physical device      http://<your LAN IP>:8000
API_BASE_URL=http://localhost:8000
